    {
      "parameters": {
        "jsCode": "const message = $input.first().json.message || {};\nconst textMsg = (message.text || \"\").toString().toLowerCase().trim();\n\nconst greetings = [\n  \"hi\", \"hello\", \"hey\", \"help\", \"start\", \"/start\", \"menu\",\n  \"مرحبا\", \"مرحباً\", \"السلام عليكم\", \"سلام\", \"👋\", \"👍\"\n];\n\nconst isGreetingWord = greetings.includes(textMsg) || textMsg.match(/^(hi|hello|hey|مرحبا|مرحباً|السلام عليكم|👋|👍)$/i);\nconst isStickerOrMedia = !!(message.sticker || message.animation);\n\nconst isGreeting = isGreetingWord || isStickerOrMedia;\n\nreturn [{\n  json: {\n    chatInput: message.text || (isStickerOrMedia ? \"[Sticker/Media]\" : \"\"),\n    isGreeting: isGreeting\n  }\n}];"
      },
