      "parameters": {
        "jsCode": "const message = $input.first().json.message || {};\nconst textMsg = (message.text || \"\").toString().toLowerCase().trim();\n\n// Treat stickers, photos, voice, video as greetings\nconst isMedia = !!(message.sticker || message.photo || message.voice || message.video || message.document || message.audio);\n\nconst greetingPatterns = [\n  \"hi\", \"hello\", \"hey\", \"help\", \"start\", \"/start\", \"menu\",\n  \"مرحبا\", \"مرحباً\", \"السلام عليكم\", \"وعليكم السلام\", \"سلام\",\n  \"هلا\", \"هلو\", \"صباح الخير\", \"مساء الخير\", \"كيفك\", \"كيف الحال\",\n  \"👋\", \"👍\", \"🙏\", \"😊\", \"✌️\"\n];\n\nconst isGreetingWord = greetingPatterns.includes(textMsg);\nconst isGreetingPattern = /^(hi+|hello+|hey+|مرحب|سلام|هلا|👋|👍|🙏)/i.test(textMsg);\nconst isShortNonQuery = textMsg.length > 0 && textMsg.length < 6 && !/[a-z]{2,}\\d+/i.test(textMsg);\n\nconst isGreeting = isMedia || isGreetingWord || isGreetingPattern || (isShortNonQuery && !textMsg.match(/cow|cwn|site|fuel|فيول|بيانات/i));\n\nreturn [{\n  json: {\n    ...($input.first().json),\n    isGreeting,\n    chatInput: message.text || (message.sticker ? \"[sticker]\" : \"[media]\")\n  }\n}];"
      },
